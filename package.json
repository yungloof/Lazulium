{
  "name": "lazulium",
  "version": "2.4.0",
  "description": "Lazulium - Hub universal de jogos para PC e emuladores, com horas jogadas, conquistas e backup de saves",
  "main": "./out/main/index.js",
  "author": {
    "name": "Lazuli Fool",
    "email": "yungloof06@gmail.com"
  },
  "homepage": "https://yungloof.github.io/Lazulium/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yungloof/Lazulium.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && node scripts/check-package.mjs && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:portable": "npm run build && node scripts/check-package.mjs && electron-builder --win portable --x64",
    "check:package": "node scripts/check-package.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "productName": "Lazulium",
  "build": {
    "appId": "com.lazulium.app",
    "productName": "Lazulium",
    "copyright": "Copyright © 2026 Lazuli Fool",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yungloof",
        "repo": "Lazulium"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/{react,react-dom,scheduler,lucide-react,zustand,clsx,tailwind-merge}/**"
    ],
    "extraResources": [
      {
        "from": "web/profile",
        "to": "web-profile",
        "filter": [
          "index.html"
        ]
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.ico",
          "icon.png",
          "tray.ico"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerSidebar": "resources/installerSidebar.bmp",
      "installerHeader": "resources/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lazulium",
      "runAfterFinish": true,
      "uninstallDisplayName": "Lazulium",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lazulium-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lazulium-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
